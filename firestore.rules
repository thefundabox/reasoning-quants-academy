rules_version = '2';

// Security rules for mobile-number sign-in (see README.md, "Mobile login").
// Paste this into Firebase console → Firestore Database → Rules, and Publish.
//
// A signed-in learner may read and write exactly one document — their own,
// learners/<their uid> — and nothing else. There are no admin reads from the
// browser: the site's code runs on the learner's device, so any rule relaxed
// "for the app" is relaxed for anyone holding a browser console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /learners/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'phone', 'name', 'progress', 'updatedAt'])
        && request.resource.data.v == 1
        // The number stored is the number that signed in — not one typed in.
        && request.resource.data.phone == request.auth.token.phone_number
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.progress is string && request.resource.data.progress.size() < 900000;
    }

    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
